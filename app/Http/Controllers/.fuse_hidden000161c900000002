                    'message' => 'La demande a bien été validée.'
                ];
            }
        } 

        // Vérifier si des erreurs sont présentes dans les résultats
        $errors = array_filter($results, function ($result) {
            return $result['error'] === 1;
        });
         
        if (!empty($errors)) {
            // Il y a des erreurs, renvoyer la réponse appropriée
            return response()->json($errors[0]); // Vous pouvez ajuster le renvoi en fonction de vos besoins
        } else {
            // Aucune erreur, renvoyer la réponse globale
            return response()->json([
                'error' => 0,
                'message' => 'Toutes les demandes ont été validées avec succès.'
            ]);
        }
        
        // dd($result);

