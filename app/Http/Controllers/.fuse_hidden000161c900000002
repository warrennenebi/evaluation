                        $nouveauNombreDeJours = $userProfile->jour_de_conger - $demande_recupere->nombre_de_jours;

                        // Mettre à jour la colonne jour_de_conger du modèle UserProfile
                        $userProfile->update(['jour_de_conger' => $nouveauNombreDeJours]);
